# =============================================================================
# SKHD CONFIGURATION for YABAI
# Location: ~/.skhdrc
# =============================================================================

# --- 1. Navigation (Focus) ---
# Move focus between windows in the current space
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# --- 2. Window Manipulation (Moving) ---
# Swap window positions
shift + alt - h : yabai -m window --swap west
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - l : yabai -m window --swap east

# Warp window (move window and re-tile)
ctrl + alt - h : yabai -m window --warp west
ctrl + alt - j : yabai -m window --warp south
ctrl + alt - k : yabai -m window --warp north
ctrl + alt - l : yabai -m window --warp east

# --- 3. Layout & Styling ---
# Toggle window zoom (Fullscreen)
alt - f : yabai -m window --toggle zoom-fullscreen

# Toggle window split type (Horizontal/Vertical)
alt - e : yabai -m window --toggle split

# Float / Unfloat window
alt - t : yabai -m window --toggle float --grid 4:4:1:1:2:2

# Balance size of all windows in space
shift + alt - b : yabai -m space --balance

# --- 4. Space Management ---
# Focus specific space
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5

# Send window to space and follow focus
shift + alt - 1 : yabai -m window --space 1; yabai -m space --focus 1
shift + alt - 2 : yabai -m window --space 2; yabai -m space --focus 2
shift + alt - 3 : yabai -m window --space 3; yabai -m space --focus 3
shift + alt - 4 : yabai -m window --space 4; yabai -m space --focus 4
shift + alt - 5 : yabai -m window --space 5; yabai -m space --focus 5

# --- 5. Resizing ---
# Expand window size
ctrl + shift - h : yabai -m window --resize left:-20:0
ctrl + shift - j : yabai -m window --resize bottom:0:20
ctrl + shift - k : yabai -m window --resize top:0:-20
ctrl + shift - l : yabai -m window --resize right:20:0

# Set layout to BSP (Tiling)
alt - b : yabai -m space --layout bsp

# Set layout to Stacked
alt - s : yabai -m space --layout stack

# Set layout to Floating
alt - f : yabai -m space --layout float

# --- 6. System & App Launchers ---
# Restart Yabai/SKHD (Crucial when you edit this file)
shift + alt - r : yabai --restart-service; skhd --restart-service

# Open Terminal (Adjust for your preferred terminal app)
alt - return : open -a iTerm
